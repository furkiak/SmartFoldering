<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SmartFoldering" xmlns:models="using:SmartFoldering.Models"
        x:Class="SmartFoldering.TargetFoldersWindow" x:DataType="local:TargetFoldersWindow"
        Title="Destination folders" Width="520" Height="650" MinWidth="360" MinHeight="350"
        SystemDecorations="Full" WindowStartupLocation="Manual" CanResize="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Destinations" FontWeight="Bold" FontSize="{DynamicResource HeadingFontSize}"/>
            <TextBlock Text="{Binding FolderName}" Foreground="{DynamicResource SecondaryText}"/>
            <WrapPanel>
                <Button Content="Add destination" Classes="ActionBtn" Click="AddTargetFolder_Click"/>
                <Button Content="Back" Classes="ActionBtn" Click="Back_Click"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding ObservableTargets}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TargetFolder">
                        <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{DynamicResource SectionFontSize}"/>
                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
                                <WrapPanel>
                                    <Button Content="Delete" Classes="ActionBtn" Click="DeleteTarget_Click" CommandParameter="{Binding}"/>
                                    <Button Content="Edit" Classes="ActionBtn" Click="EditTarget_Click" CommandParameter="{Binding}"/>
                                    <Button Content="Filters" Classes="DestBtn" Click="OpenRules_Click" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Window>
