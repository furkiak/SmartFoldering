<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartFoldering.ViewModels"
        x:Class="SmartFoldering.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="SmartFoldering" Icon="/Assets/smartfoldering.ico"
        Width="680" Height="750" MinWidth="380" MinHeight="400"
        SystemDecorations="Full" WindowStartupLocation="Manual" CanResize="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="SmartFoldering" FontWeight="Bold" FontSize="{DynamicResource HeadingFontSize}"/>
            <TextBlock Text="Review local file moves before enabling monitoring." Foreground="{DynamicResource SecondaryText}"/>
            <WrapPanel>
                <Button Content="Settings" Classes="ActionBtn" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings"/>
                <Button Content="Add source folder" Classes="ActionBtn" Command="{Binding AddWatchFolderCommand}"/>
                <Button Content="Hide window" Classes="ActionBtn" Click="HideWindow_Click"/>
                <Button Content="Quit" Classes="ActionBtn" Click="ExitWindow_Click" AutomationProperties.Name="Quit SmartFoldering"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding WatchFolders}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{DynamicResource SectionFontSize}"/>
                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
                                <WrapPanel>
                                    <Button Content="Delete" Classes="ActionBtn" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteWatchFolderCommand}" CommandParameter="{Binding}"/>
                                    <Button Content="Edit" Classes="ActionBtn" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditWatchFolderCommand}" CommandParameter="{Binding}"/>
                                    <Button Content="Destinations" Classes="DestBtn" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDestinationsCommand}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentText}"/>
            <WrapPanel>
                <Button Content="Preview moves" Classes="ActionBtn" Command="{Binding PreviewCommand}"/>
                <Button Content="{Binding MonitoringButtonText}" Classes="DestBtn" Command="{Binding ToggleMonitoringCommand}"/>
                <Button Content="Undo last move" Classes="ActionBtn" Command="{Binding UndoLastCommand}"/>
                <Button Content="Scan now" Classes="ActionBtn" Command="{Binding ForceScanCommand}"/>
            </WrapPanel>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Proposed moves · read-only" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PreviewText}" FontSize="{DynamicResource CaptionFontSize}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Recent operations" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RecentMoveText}" FontSize="{DynamicResource CaptionFontSize}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
