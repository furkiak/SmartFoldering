<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartFoldering.SettingsWindow" Title="SmartFoldering Settings"
        Width="480" Height="700" MinWidth="360" MinHeight="360"
        SystemDecorations="Full" WindowStartupLocation="CenterOwner" CanResize="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="18">
            <TextBlock Text="Settings" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
            <TextBlock Text="Appearance" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold"/>
            <TextBlock Text="Theme" Foreground="{DynamicResource SecondaryText}"/>
            <ComboBox x:Name="ThemeChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Theme">
                <ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
            </ComboBox>
            <TextBlock Text="Text size" Foreground="{DynamicResource SecondaryText}"/>
            <ComboBox x:Name="TextSizeChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Text size">
                <ComboBoxItem Content="100%"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/>
            </ComboBox>
            <TextBlock Text="Enlarges text throughout the app. Window size and Windows display scaling stay independent. Save applies to this profile. Surfaces are opaque; decorative motion is disabled." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
            <TextBlock Text="Windows startup" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold"/>
            <CheckBox x:Name="StartupCheckBox" HorizontalAlignment="Stretch" Content="Run at Windows sign-in"/>
            <TextBlock x:Name="StartupDescription" Text="Opens SmartFoldering when you sign in. Monitoring resumes only if it was enabled before the previous exit." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
            <TextBlock x:Name="FeedbackText" IsVisible="False" Foreground="{DynamicResource WarningText}"/>
            <WrapPanel>
                <Button Content="Cancel" Classes="ActionBtn" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Save" Classes="DestBtn" Click="Save_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
