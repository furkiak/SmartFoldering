<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartFoldering.RuleDialogWindow" Title="Filter details"
        Width="480" Height="580" MinWidth="360" MinHeight="300" SystemDecorations="Full"
        WindowStartupLocation="CenterOwner" CanResize="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="18">
            <TextBlock Text="Filter details" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
            <TextBlock Text="Rule type" Foreground="{DynamicResource SecondaryText}"/>
            <StackPanel Spacing="10">
                <RadioButton x:Name="ExtensionRadio" Content="Extension (.pdf)" IsChecked="True"/>
                <RadioButton x:Name="KeywordRadio" Content="Keyword (text)"/>
            </StackPanel>
            <TextBlock Text="Value" Foreground="{DynamicResource SecondaryText}"/>
            <TextBox x:Name="ValueTextBox" Watermark="e.g. .jpg or invoice" AutomationProperties.Name="Filter value"/>
            <Border x:Name="ErrorBox" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="False">
                <TextBlock Foreground="{DynamicResource WarningText}" Text="Conflict: this rule already exists in another folder."/>
            </Border>
            <WrapPanel Margin="0,12,0,0">
                <Button Content="Cancel" Classes="ActionBtn" Click="Cancel_Click"/>
                <Button Content="Save" Classes="DestBtn" Click="Save_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
