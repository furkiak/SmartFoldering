<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartFoldering.NotificationWindow" Width="460" MaxHeight="600" SizeToContent="Height"
        SystemDecorations="None" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TitleBlock" Text="SmartFoldering active" FontWeight="Bold" FontSize="{DynamicResource SectionFontSize}"/>
                <TextBlock x:Name="MessageBlock" Text="Monitoring approved folders in the background." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
