<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SmartFoldering" xmlns:models="using:SmartFoldering.Models"
        x:Class="SmartFoldering.RulesWindow" x:DataType="local:RulesWindow"
        Title="Filters" Width="520" Height="650" MinWidth="360" MinHeight="350"
        SystemDecorations="Full" WindowStartupLocation="Manual" CanResize="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Filters" FontWeight="Bold" FontSize="{DynamicResource HeadingFontSize}"/>
            <TextBlock Text="{Binding TargetName}" Foreground="{DynamicResource SecondaryText}"/>
            <WrapPanel>
                <Button Content="Add filter" Classes="ActionBtn" Click="AddRule_Click"/>
                <Button Content="Back" Classes="ActionBtn" Click="Back_Click"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding ObservableRules}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Rule">
                        <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
                                <TextBlock Text="{Binding Value}" FontWeight="Bold" FontSize="{DynamicResource SectionFontSize}"/>
                                <WrapPanel><Button Content="Delete" Classes="ActionBtn" Click="DeleteRule_Click" CommandParameter="{Binding}"/></WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Window>
