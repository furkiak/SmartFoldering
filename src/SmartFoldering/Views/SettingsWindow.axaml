<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartFoldering.ViewModels"
        xmlns:loc="using:SmartFoldering.Localization"
        xmlns:ctl="using:SmartFoldering.Views.Controls"
        x:Class="SmartFoldering.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="SmartFoldering"
        Width="480" Height="910"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/SmartFoldering.ico"
        KeyDown="OnKeyDown">

    <Window.Styles>
        <!-- Fluent sliders carry generous built-in padding; these rows already have their own spacing. -->
        <Style Selector="Slider">
            <Setter Property="Margin" Value="0,-4,0,-12"/>
        </Style>
    </Window.Styles>

    <Border Classes="windowRoot">
        <Grid>
            <ctl:AuroraBackground/>

            <Grid RowDefinitions="Auto,*,Auto" Margin="22,20,22,20">
                <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnHeaderPointerPressed" Margin="0,0,0,14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T settings.title}" Classes="h1"/>
                        <TextBlock Text="{loc:T settings.subtitle}" Classes="cap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Click="Close_Click" VerticalAlignment="Top">
                        <Path Classes="glyph" Data="{StaticResource IconClose}" Width="13" Height="13"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,0,-10,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,10,4">

                        <StackPanel Spacing="7">
                            <TextBlock Text="{loc:T settings.appearance}" Classes="cap" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            <Border Classes="glass tile" Padding="16,14">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                                        <TextBlock Text="{loc:T settings.language}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ListBox Grid.Column="1" Classes="segmented" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                            <ListBoxItem Content="{loc:T lang.auto}"/>
                                            <ListBoxItem Content="{loc:T lang.en}"/>
                                            <ListBoxItem Content="{loc:T lang.tr}"/>
                                        </ListBox>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                                        <TextBlock Text="{loc:T settings.theme}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ListBox Grid.Column="1" Classes="segmented" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                            <ListBoxItem Content="{loc:T theme.system}"/>
                                            <ListBoxItem Content="{loc:T theme.light}"/>
                                            <ListBoxItem Content="{loc:T theme.dark}"/>
                                        </ListBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="{loc:T settings.sorting}" Classes="cap" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            <Border Classes="glass tile" Padding="16,14">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{loc:T settings.quiet}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QuietText}" Classes="cap num"/>
                                        </Grid>
                                        <TextBlock Text="{loc:T settings.quiet.desc}" Classes="micro" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <Slider Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding QuietSeconds, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Border Classes="divider"/>
                                    <StackPanel Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{loc:T settings.rescan}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RescanText}" Classes="cap num"/>
                                        </Grid>
                                        <TextBlock Text="{loc:T settings.rescan.desc}" Classes="micro" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <Slider Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding RescanMinutes, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Border Classes="divider"/>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:T settings.conflict}" FontWeight="SemiBold"/>
                                        <ListBox Classes="segmented" SelectedIndex="{Binding ConflictIndex, Mode=TwoWay}">
                                            <ListBoxItem Content="{loc:T conflict.keep}"/>
                                            <ListBoxItem Content="{loc:T conflict.skip}"/>
                                        </ListBox>
                                        <TextBlock Text="{loc:T settings.conflict.desc}" Classes="micro" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="{loc:T settings.system}" Classes="cap" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            <Border Classes="glass tile" Padding="16,14">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsStartupSupported}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{loc:T startup.enable}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:T startup.desc}" Classes="micro" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Classes="divider" IsVisible="{Binding IsStartupSupported}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{loc:T notify.enable}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:T notify.desc}" Classes="micro" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Notifications, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{loc:T data.hint}" Classes="micro" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Grid.Column="1" Classes="glass" Command="{Binding OpenDataFolderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="glyph" Data="{StaticResource IconFolder}" Width="14" Height="14"/>
                                                <TextBlock Text="{loc:T data.open}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                    <TextBlock Text="{Binding VersionText}" Classes="micro" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Grid.Column="1" Classes="accent" Click="Close_Click" Padding="32,10">
                        <TextBlock Text="{loc:T settings.done}"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
