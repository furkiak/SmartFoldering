<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartFoldering.App"
             Name="SmartFoldering"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml"/>
                <ResourceInclude Source="/Styles/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#007AFF" RegionColor="#F2F2F7" ErrorText="#D70015"/>
                <ColorPaletteResources x:Key="Dark" Accent="#0A84FF" RegionColor="#1C1C1E" ErrorText="#FF6961"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/Controls.axaml"/>
    </Application.Styles>
</Application>
